<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No INTERNET, and nothing in the app that would use it: the herb book is in the APK and
        everything else stays on the phone. A source's address or "Feed the llamas" is handed to
        the browser, which needs no permission here.

        The brew timer, and nothing else, asks for these (the house approach of Parked's meter):
    -->
    <!-- So the tea rings at its second: an exact alarm. Given at install to an app built for
         Android 12, as this one is; USE_EXACT_ALARM would count only from Android 13 targets. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The ring is a notification with Stop; Android 13 and later ask for it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The service that plays the ring for up to a minute, with the screen off and the app away,
         and keeps the phone awake that long. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <!-- Home, whose dark mode switch this app follows when Home is installed. -->
        <package android:name="com.wanderwildwood.iori" />
        <!-- A browser, for a source's address and "Feed the llamas". -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- The apps that act on selected text, Define among them, for the menu over a selection. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Cabinet (Files), whose own screens open and save files (the copy of the journal and cupboard). -->
        <package android:name="com.wanderwildwood.tana" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_mudita"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <!-- Starts dark mode before the first screen is drawn. Holds no data. -->
        <provider
            android:name="com.wanderwildwood.yakuso.ui.DarkModeInit"
            android:authorities="${applicationId}.darkmodeinit"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Plays the ring when a brew is done, and only then. -->
        <service
            android:name=".timer.RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The brew's exact alarm, and Stop on its notification. -->
        <receiver
            android:name=".timer.BrewReceiver"
            android:exported="false" />

        <!-- An update, or exact alarms allowed again: the brew's alarm is set again. -->
        <receiver
            android:name=".timer.SystemReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
