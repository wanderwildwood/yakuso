<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No permissions at all. No INTERNET, and nothing in the app that would use it: the herb
        book is in the APK and everything else stays on the phone. A source's address or
        "Feed the llamas" is handed to the browser, which needs no permission here.
    -->

    <queries>
        <!-- Home, whose dark mode switch this app follows when Home is installed. -->
        <package android:name="com.wanderwildwood.iori" />
        <!-- A browser, for a source's address and "Feed the llamas". -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- The apps that act on selected text, Define among them, for the menu over a selection. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Cabinet (Files), whose own screens open and save files (the journal's backup, later). -->
        <package android:name="com.wanderwildwood.tana" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_mudita"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <!-- Starts dark mode before the first screen is drawn. Holds no data. -->
        <provider
            android:name="com.wanderwildwood.yakuso.ui.DarkModeInit"
            android:authorities="${applicationId}.darkmodeinit"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
